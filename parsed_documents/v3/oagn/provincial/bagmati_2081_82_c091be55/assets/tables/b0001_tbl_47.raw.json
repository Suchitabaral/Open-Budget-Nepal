          "r": 523.3333333333334,
          "b": 277.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| मौसम पूर्व सूचना प्रणाली विकास नभएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.66666666666667,
