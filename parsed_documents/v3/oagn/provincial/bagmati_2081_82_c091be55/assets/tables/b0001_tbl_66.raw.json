        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "रोजगार फोरम स्थापना नभएको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.66666666666667,
          "t": 158.33333333333334,
