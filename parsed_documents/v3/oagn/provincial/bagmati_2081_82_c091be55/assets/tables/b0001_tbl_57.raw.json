        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| जलाधारको व्यवस्थापनसम्बन्धी कानुन नीति र मापदण्ड तयार नभएको ।",
        "column_header": false,
        "row_header": false,
