FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    HF_HOME=/home/raguser/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/home/raguser/.cache/sentence-transformers

WORKDIR /app

RUN apt-get update && apt-get install -y \
    ca-certificates \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.rag.txt .

RUN python -m pip install --upgrade pip && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu \
      -r requirements.rag.txt

COPY rag_service/ ./rag_service/

RUN useradd -m -u 1000 raguser && \
    mkdir -p /app/.rag /home/raguser/.cache/huggingface /home/raguser/.cache/sentence-transformers && \
    chown -R raguser:raguser /app /home/raguser/.cache
USER raguser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/')" || exit 1

CMD ["uvicorn", "rag_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
