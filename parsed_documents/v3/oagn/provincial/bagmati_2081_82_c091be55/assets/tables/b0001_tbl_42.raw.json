            "r": 375.0,
            "b": 245.0,
            "coord_origin": "TOPLEFT"
          },
          "row_span": 1,
          "col_span": 1,
          "start_row_offset_idx": 4,
          "end_row_offset_idx": 5,
          "start_col_offset_idx": 0,
          "end_col_offset_idx": 1,
          "text": "प्रदेशमा सञ्चालित सूचना प्रविधिसँग सम्बन्धित कम्पनीहरूलाई आइ.टी. पार्कभित्र वर्कस्टेशन सञ्चालन गर्न निःशुल्क स्थान उपलब्ध गराउने र त्यस्तो वर्कस्टेसनमा सूचीकृत भई काम गर्ने आइ.टी. कम्पनीहरूबाट उत्पादित वस्तु तथा सेवा बिक्रीको आधारमा प्रोत्साहन सुविधा उपलब्ध गराउने |",
          "column_header": false,
          "row_header": false,
          "row_section": false,
          "fillable": false
        },
        {
          "bbox": {
            "l": 385.0,
            "t": 214.0,
            "r": 446.3333333333333,
            "b": 223.66666666666666,
            "coord_origin": "TOPLEFT"
          },
          "row_span": 1,
          "col_span": 1,
          "start_row_offset_idx": 4,
          "end_row_offset_idx": 5,
          "start_col_offset_idx": 1,
          "end_col_offset_idx": 2,
          "text": "कार्यान्वयन नभएको",
          "column_header": false,
          "row_header": false,
          "row_section": false,
          "fillable": false
        }
      ],
      [
        {
          "bbox": {
            "l": 113.0,
            "t": 246.66666666666666,
            "r": 375.0,
            "b": 270.3333333333333,
            "coord_origin": "TOPLEFT"
          },
          "row_span": 1,
          "col_span": 1,
          "start_row_offset_idx": 5,
          "end_row_offset_idx": 6,
          "start_col_offset_idx": 0,
          "end_col_offset_idx": 1,
          "text": "व्यवसाय दर्ता, नवीकरण लगायतका कार्यलाई आगामी आर्थिक वर्षदेखि अनलाइन प्रणालीमा आवद्ध गर्ने |",
          "column_header": false,
          "row_header": false,
          "row_section": false,
          "fillable": false
        },
        {
          "bbox": {
            "l": 385.0,
