        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "कार्यान्वयन अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
