        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "बायो इन्जिनियरिङ्ग प्रविधिको प्रयोग गर्दै जैविक, भौतिव तथा मानवीय दृष्टिले जोखिमपूर्ण जलाधार क्षेत्रहरूको संरक्षण तथा व्यवस्थापन गरिने।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.33333333333333,
          "t": 280.6666666666667,
          "r": 134.0,
          "b": 288.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
