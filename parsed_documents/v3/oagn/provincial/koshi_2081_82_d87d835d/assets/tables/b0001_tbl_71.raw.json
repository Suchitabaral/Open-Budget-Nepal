        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "[ नीति कार्यक्रम P",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 218.0,
