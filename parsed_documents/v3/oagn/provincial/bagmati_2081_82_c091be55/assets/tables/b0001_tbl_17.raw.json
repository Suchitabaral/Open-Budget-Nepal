        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "कार्यक्रम",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 496.3333333333333,
          "r": 382.0,
          "b": 536.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेश सुशासन केन्द्रलाई प्रादेशिक प्रशिक्षण तथा तालिम केन्द्रका रूपमा विकास गरिने, केन्द्र मार्फत प्रदेश र स्थानीय तहका जनप्रतिनिधि, पदाधिकारी र कर्मचारीहरूको क्षमता अभिवृद्धि गर्नुका साथै अध्ययन अनुसन्धान गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 429.3333333333333,
          "t": 482.3333333333333,
          "r": 484.3333333333333,
          "b": 491.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वन अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 392.0,
          "t": 496.3333333333333,
          "r": 521.6666666666666,
          "b": 532.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रादेशिक प्रशिक्षण तथा तालिम केन्द्रको रूपमा विकास गर्नसो सम्बन्धी तयारीको क्रममा रहेको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 537.3333333333334,
          "r": 382.0,
          "b": 575.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "सार्वजनिक सेवा प्रवाहलाई सुशासनयुक्त बनाउन छिटो छरितो, मितव्ययी र प्रभावकारी रूपमा विद्युतीय शासनलाई अवलम्बन गर्दै प्रदेशकासबै कार्यालयहरूमा स्व:चालित प्रणाली लागु गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 392.0,
          "t": 536.3333333333334,
          "r": 521.6666666666666,
          "b": 575.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सबै मन्त्रालय तथा निकायहरूमा एकीकृत सरकारी कार्यालय व्यवस्थापन प्रणाली लागु गरेको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 578.0,
          "r": 382.3333333333333,
          "b": 613.3333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेश किताबखानाको संस्थागत सुदृढीकरण गरी कर्मचारीको सिटरोल, सम्पत्ति विवरण र तलबी प्रतिवेदन व्यवस्थापन साथै स्थानीय तहका कर्मचारीहरूको वैयक्तिक अभिलेख प्रणाली सञ्चालन गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 392.0,
          "t": 591.3333333333334,
          "r": 469.6666666666667,
          "b": 602.6666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वयन हुन नसकेको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 617.3333333333334,
          "r": 382.0,
          "b": 670.3333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "आगामी आर्थिक वर्ष प्रदेश निजामती सेवा तथा स्थानीय सेवासँग सम्बन्धित नियमावली तर्जुमा गर्ने, प्रदेश तथा स्थानीय तहमा कार्यरत कर्मचारीहरूको वृत्ति विकास अनुमानयोरय वनाई कर्मचारी सरुवालाई प्रदेशको भौगोलिक विशिष्टताको अनुभव प्राप्त हुने गरी चक्रीय प्रणालीमा आबद्ध गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 392.0,
          "t": 632.3333333333334,
          "r": 521.6666666666666,
          "b": 656.6666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "निजामती सेवा नियमावली र सरुवा मापदण्ड तर्जुमा प्रकृयामा रहेको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 673.0,
          "r": 382.0,
          "b": 695.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "भ्रष्टाचार न्यूनीकरणका लागि प्रवर््धनात्मक, निरोधात्मक तथा उपचारात्मक उपाय सहित प्रादेशिक रणनीतिक कार्ययोजना तयार गरी कार्यान्वयन गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 392.0,
          "t": 680.0,
          "r": 504.3333333333333,
          "b": 689.6666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "रणनीतिक कार्ययोजना तयार नभएको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      }
    ],
