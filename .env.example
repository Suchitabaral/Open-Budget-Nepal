# Core application ports
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=8080

# PostgreSQL development defaults; replace these for public deployments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_budget_nepal

# Browser-facing API URL compiled into the frontend image
VITE_API_BASE_URL=http://localhost:3001/api
VITE_RAG_API_BASE_URL=http://localhost:8000/api/v1

# Comma-separated browser origins accepted by the Express API
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# RAG API and browser origins
RAG_PORT=8000
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Required when running the chatbot or ingesting its RAG corpus
PINECONE_API_KEY=
GEMINI_API_KEY=

# Pinecone single-index hybrid search (dense + sparse, dot product)
PINECONE_INDEX_NAME=budgetrag
PINECONE_NAMESPACE=open-budget-nepal
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_UPSERT_BATCH_SIZE=64
PINECONE_READY_TIMEOUT=120

# Parsed OCR artifacts and local BM25 state
PARSED_DOCUMENTS_DIR=parsed_documents
RAG_BM25_PARAMS=.rag/bm25_params.json

# intfloat/multilingual-e5-base
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=cpu

# Gemini generation and multilingual query expansion
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
RAG_QUERY_EXPANSION=true

# Chunking and retrieval
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MIN_QUALITY_SCORE=0.25
RAG_RETRIEVAL_K=6
RAG_HYBRID_ALPHA=0.7
RAG_QUERY_EXPANSION_CANDIDATES=12
RAG_MAX_CONTEXT_CHARACTERS=14000

# Evaluation
RAGAS_EVALUATOR_MODEL=gemini-3.6-flash
