          "r": 481.6666666666667,
          "b": 166.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वयनको अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
          "t": 172.33333333333334,
          "r": 350.6666666666667,
          "b": 272.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "अन्तर प्रदेश समन्वयमा जनकपुर, लुम्बिनी, देवघाट र मुक्तिनाथ जोड्ने सांस्कृतिक सम्पदा परिपथ विकास गर्ने, चितवनका सौराह, मेघौली, माडी र सिराइचुली जोडेर पर्यापर्यटन परिपथ, पाटन दरबार क्षेत्र, वसन्तपुर, कीर्तिपुर, भक्तपुर र चाँगुनारायण क्षेत्र जोडेर सम्पदा परिपथ र काठमाडौंको पशुपतिनाथ, डोलेश्वर, दत्तात्रेय, सुवर्णेधर, अनन्त लिङ्गेघवर, सन्तानेश्वर, महादेव पोखरी जोडेर शिव पथ विकास गर्ने।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 353.3333333333333,
          "t": 171.0,
          "r": 429.6666666666667,
          "b": 186.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "| कार्यान्वयन नभएको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
          "t": 278.6666666666667,
          "r": 350.6666666666667,
          "b": 334.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "बागमती प्रदेशमा रहेका विभिन्न जात्रा तथा पर्वहरूको संरक्षण र सञ्चालनका लागि अक्षयकोष स्थापना गर्ने, कला, संस्कृति, भाषा, लिपि, जातजाति, धर्म, बाजागाजा आदिका बारेमा अध्ययन अनुसन्धान गर्न चाहने अध्येताहरूलाई प्रोत्साहन गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 354.6666666666667,
          "t": 277.3333333333333,
          "r": 526.0,
          "b": 351.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "| अक्षयकोषको स्थापनाको लागि रु.५ करोड | बजेट विनियोजन भएकोमा कार्यक्रम सञ्चालनमा | नआएको, अध्येताहरूलाई प्रोत्साहनको लागि सूचना प्रकाशन गरेकोमा प्रस्ताव नपरेकोले कार्यान्वयन हुन नसकेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
          "t": 353.6666666666667,
          "r": 350.6666666666667,
          "b": 394.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "चितवनका सौराहा, मेघौली, गोलाघाट, भक्तपुरको नगरकोट, दोलखाको शैलुङ क्षेत्रलाई खुला चलचित्र छायांकन क्षेत्रको रूपमा विकास गर्ने।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 353.3333333333333,
          "t": 352.3333333333333,
          "r": 526.0,
          "b": 383.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "| बजेट विनियोजन नभएको कारण कार्यान्वयन | हुन नसकेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
          "t": 400.6666666666667,
          "r": 350.6666666666667,
          "b": 470.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेश भ्रमण वर्ष २०२४ को निरन्तरता सहित प्रदेश भित्रका पर्यटकीय गन्तव्य तथा पर्यटन क्रियाकलापहरूको प्रवर्धन कार्यक्रम सञ्चालन गर्ने, बाहा पर्यटकको सङ्ख्या वृद्धि गर्न छिमेकी मुलुकका प्रमुख सहरहरूमा पर्यटक लक्षित रोड शो, मेला, महोत्सव जस्ता पर्यटन प्रवर्धन कार्यक्रम सञ्चालन T |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 354.3333333333333,
          "t": 399.3333333333333,
          "r": 451.3333333333333,
          "b": 415.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "| कार्यान्वयन हुन नसकेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 107.66666666666667,
          "t": 477.0,
          "r": 350.6666666666667,
          "b": 519.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "बागमती प्रदेशलाई आकर्षक पर्यटक गन्तव्यको रूपमा विकास गरी पर्यटकको बसाइ अवधि लम्व्याउन र प्रति पर्यटक खर्च वृद्धि गर्न पर्यटन पूर्वाधार निर्माण तथा सुधार गर्ने ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 353.6666666666667,
          "t": 475.6666666666667,
          "r": 526.0,
          "b": 505.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "| पर्यटकको आगमन, बसाइ अवधि एवं प्रति | पर्यटक खर्च सम्बन्धमा अभिलेख नराखेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      }
    ],
