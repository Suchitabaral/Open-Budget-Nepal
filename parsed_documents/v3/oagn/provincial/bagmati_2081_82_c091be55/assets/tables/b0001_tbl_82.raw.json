        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सूचना प्रणालीलाई कार्यान्वयनमा सञ्चालन हुने आयोजना छनोट | बनाइने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
