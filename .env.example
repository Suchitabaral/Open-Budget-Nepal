# Required services
PINECONE_API_KEY=your-pinecone-api-key
GEMINI_API_KEY=your-gemini-api-key

# Pinecone single-index hybrid search (dense + sparse, dotproduct)
PINECONE_INDEX_NAME=budgetrag
PINECONE_NAMESPACE=open-budget-nepal
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_UPSERT_BATCH_SIZE=64
PINECONE_READY_TIMEOUT=120

# Parsed OCR artifact and local BM25 state
PARSED_DOCUMENTS_DIR=parsed_documents
RAG_BM25_PARAMS=.rag/bm25_params.json

# intfloat/multilingual-e5-base
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=cpu

# Gemini generation and multilingual query expansion
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
RAG_QUERY_EXPANSION=true

# Chunking and retrieval
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MIN_QUALITY_SCORE=0.25
RAG_RETRIEVAL_K=6
RAG_HYBRID_ALPHA=0.7
RAG_QUERY_EXPANSION_CANDIDATES=12
RAG_MAX_CONTEXT_CHARACTERS=14000

# API and evaluation
RAG_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RAGAS_EVALUATOR_MODEL=gemini-3.6-flash
