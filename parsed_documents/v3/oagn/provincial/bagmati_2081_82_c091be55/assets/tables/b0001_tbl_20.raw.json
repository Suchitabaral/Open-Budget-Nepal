        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "१९२",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 146.66666666666666,
          "t": 211.33333333333334,
          "r": 252.66666666666666,
          "b": 222.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "|प्रदेश अनुसन्धान व्युरो गठन गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 361.6666666666667,
          "t": 211.33333333333334,
          "r": 428.6666666666667,
          "b": 221.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "बजेट समर्पण भएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 146.66666666666666,
          "t": 225.33333333333334,
          "r": 356.6666666666667,
          "b": 247.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रत्येक जिल्ला सदरमुकाममा सार्वजनिक नागरिक प्रदर्शन स्थल निर्माण गर्ने ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 358.6666666666667,
          "t": 224.0,
          "r": 428.6666666666667,
          "b": 237.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| बजेट समर्पण भएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 146.66666666666666,
          "t": 251.66666666666666,
          "r": 356.6666666666667,
          "b": 274.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "मानव अधिकारको सम्मान, संरक्षण र प्रवर्धन तथा फैसला कार्यान्वयनका लागि आवश्यक व्यवस्था गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 361.6666666666667,
          "t": 251.66666666666666,
          "r": 510.0,
          "b": 262.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "|फेसला कार्यान्वयन सम्बन्धी कार्यक्रम नभएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 146.66666666666666,
          "t": 280.0,
          "r": 356.6666666666667,
          "b": 302.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रदेशस्तरको डाटा सेन्टर निर्माणको सम्भाव्यता अध्ययन, डाटा सर्भर खरिद, जडान र सञ्चालन गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 361.6666666666667,
          "t": 280.0,
          "r": 522.3333333333334,
          "b": 303.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "|डाटा सेन्टरको सम्भाव्यता अध्ययन कार्य भएतापनि डाटा सर्भर खरिद तथा जडान कार्य नभएको ।",
        "column_header": false,
        "row_header": false,
