          "r": 286.3333333333333,
          "b": 129.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रादेशिक औद्योगिक नीति तथा वाणिज्य नीति तर्जुमा गर्ने | N",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 383.6666666666667,
          "t": 110.33333333333333,
          "r": 520.3333333333334,
          "b": 136.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रादेशिक औचोगिक नीति जा वाणिज्य नीति मस्यौदा छलफलको चरणमा रहेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 139.0,
          "r": 375.0,
          "b": 161.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेश लगानी बोर्ड गठनको लागि आवश्यक नीतिगत र कानुनी व्यवस्था गरी संस्थागत संरचना विकास गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 165.33333333333334,
          "r": 375.0,
          "b": 192.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "स्टार्टअप र नवप्रवर्तन कार्यक्रमलाई निजी शैक्षिक क्षेत्रसँग सहकार्य गरी आवश्यक प्राविधिक सहयोग र बीउपुँजी उपलब्ध गराउने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 193.66666666666666,
          "r": 375.0,
          "b": 245.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेशमा सञ्चालित सूचना प्रविधिसँग सम्बन्धित कम्पनीहरूलाई आइ.टी. पार्कभित्र वर्कस्टेशन सञ्चालन गर्न निःशुल्क स्थान उपलब्ध गराउने र त्यस्तो वर्कस्टेसनमा सूचीकृत भई काम गर्ने आइ.टी. कम्पनीहरूबाट उत्पादित वस्तु तथा सेवा बिक्रीको आधारमा प्रोत्साहन सुविधा उपलब्ध गराउने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
          "t": 246.66666666666666,
          "r": 375.0,
          "b": 270.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "व्यवसाय दर्ता, नवीकरण लगायतका कार्यलाई आगामी आर्थिक वर्षदेखि अनलाइन प्रणालीमा आवद्ध गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 385.0,
          "t": 145.66666666666666,
          "r": 446.3333333333333,
          "b": 155.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वयन नभएको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 385.0,
          "t": 173.0,
          "r": 446.3333333333333,
          "b": 182.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वयन नभएको",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 385.0,
          "t": 214.0,
          "r": 446.3333333333333,
          "b": 223.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
