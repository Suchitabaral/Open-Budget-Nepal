        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "अपेक्षित उपलब्धि",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 418.0,
          "t": 101.33333333333333,
          "r": 515.3333333333334,
          "b": 110.66666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
