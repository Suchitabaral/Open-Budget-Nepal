        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "२०८१।८२ सम्मको उपलब्धि",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 150.0,
          "r": 232.33333333333334,
          "b": 159.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "हरित वित्त परिचालन कार्यक्रम",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 123.33333333333333,
          "r": 406.3333333333333,
          "b": 186.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "विपद्‌ उत्थानशीलता प्रवर्धन गर्ने, जलवायु परिवर्तन अनुकूलन तथा असर न्यूनीकरण गर्ने, हरित तथा चक्रीय अर्थतन्त्र विकासमा सहयोग गर्ने र खुद शून्य कार्बन उत्सर्जनको लक्ष्य हासिलमा योगदान गर्ने आयोजनाको विकास भई हरित वित्त परिचालन ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 417.0,
          "t": 150.0,
          "r": 505.0,
          "b": 159.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "यस सम्बन्धी कार्य नभएको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 212.33333333333334,
          "r": 235.33333333333334,
          "b": 234.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "अन्तरप्रदेश र स्थानीय तह साझेदारी विकास कार्यक्रम",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 198.66666666666666,
          "r": 406.3333333333333,
          "b": 247.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सीमा जोडिएका प्रदेश र स्थानीय तहसँग सहकार्य र साझेदारीको सिद्वान्तमा सम्बन्ध सुदृढ हुने र सहलगानी र साझेदारीका क्षेत्र पहिचान भई कार्यान्वयन",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 198.66666666666666,
          "r": 519.0,
          "b": 248.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "सहलगानी र साझेदारीका क्षेत्र पहिचानका लागि लुम्बिनी प्रदेश र सुदुरपश्चिम प्रदेशसँग समन्वय तथा सहकार्य गरेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 267.6666666666667,
          "r": 235.33333333333334,
          "b": 289.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "नवउद्चम र उत्पादनशील उद्यमशीलता विकास कार्यक्रम",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 260.6666666666667,
          "r": 406.3333333333333,
          "b": 296.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "उद्यमशीलता विकासका कार्यक्रम मार्फत सूचना प्रविधिमा आधारित नवउच्चम र उत्पादनशील क्षेत्रमा थप लगानी वातावरण निर्माण ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 260.6666666666667,
          "r": 519.0,
          "b": 298.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "नवउच्चम र उत्पादनशील क्षेत्रमा लगानीमा बजेट तथा कार्यक्रम स्वीकृत |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.0,
          "t": 308.0,
          "r": 235.33333333333334,
          "b": 358.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "आन्तरिक त्र््ण परिचालनसम्बन्धी नीति, कानुन, मापदण्ड र संस्थागत संयन्त्र विकास तथा परिचालन",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 316.0,
          "r": 406.3333333333333,
          "b": 351.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "आन्तरिक त्रधण परिचालनसम्बन्धी नीति, कानुन, मापदण्ड र संस्थागत संयन्त्रको विकास र AT परिचालन |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 322.6666666666667,
          "r": 519.0,
          "b": 346.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "हालसम्म आन्तरिक परिचालन नभएको | क्र्ध्ण",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 378.0,
          "r": 235.33333333333334,
          "b": 453.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "उच्च र दिगो प्रतिफल दिने आयोजना पहिचान, सम्भाव्यता अध्ययन, प्रस्ताव तयारी सहित आयोजना बैङ्क र व्यवस्थापन सूचना प्रणाली तर्जुमा तथा सञ्चालन",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 391.6666666666667,
          "r": 406.3333333333333,
          "b": 440.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "उच्च र दिगो प्रतिफल दिने आयोजना पहिचान, सम्भाव्यता अध्ययन, प्रस्ताव तयारी सहित आयोजना बैङ्क र व्यवस्थापन सूचना प्रणाली तयार गरी त्रण परिचालन |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 371.3333333333333,
          "r": 518.6666666666666,
          "b": 461.6666666666667,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "बजेट तर्जुमा गर्दा आयोजना प्रस्ताव तथा छनोट सम्बन्धी कार्यविधि र आयोजना बेङ्ग सञ्चालन तथा व्यवस्थापन मापदण्ड, २०८१ को आधारमा आयोजना छनोट गरी बजेट प्रस्ताव भएको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 480.3333333333333,
          "r": 235.33333333333334,
          "b": 503.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "प्रदेश प्राथमिकताका आयोजना अध्ययन, विश्लेषण तथा विकास",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 473.6666666666667,
          "r": 406.3333333333333,
          "b": 509.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "अध्ययन तथा विशेषण भएका प्रदेश प्राधिमकता तथा बैदेशिक उच्च प्रतिफलयुक्त आयोजनामा वैदेशिक सहयोग परिचालनमा नेपाल सरकारसँग समन्वय |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 474.0,
          "r": 518.6666666666666,
          "b": 510.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "प्रदेश सरकारबाट प्रत्यक्ष रुपमा वैदेशिक सहायता परिचालन नभएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 137.33333333333334,
          "t": 529.0,
          "r": 235.33333333333334,
          "b": 564.3333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "कार्बन व्यापार आयोजना विकास तथा वित्तीय स्रोत परिचालन",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 242.0,
          "t": 522.3333333333334,
          "r": 406.3333333333333,
          "b": 571.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रदेशको प्राथमिकताका कृषि, पर्यटन, उद्योग, जलस्रोत तथा उर्जा क्षेत्रमा कार्बन व्यापार आयोजनाको विकास, सञ्चालल र जलवायु वित्त परिचालनको लागि आधार तयार |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 413.0,
          "t": 529.0,
          "r": 518.6666666666666,
          "b": 565.6666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "वित्त तयार प्रदेशमा परिचालनको नभएको | जलवायु आधार",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      }
    ],
