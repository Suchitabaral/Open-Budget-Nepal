        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "कार्यान्वयनको अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 378.0,
          "t": 113.66666666666667,
          "r": 523.3333333333334,
          "b": 154.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "नभएको, निर्माण भएको कारखाना प्रदेश सरकारले सञ्चालल नगरी अन्य निकायलाई सञ्चालन गर्न दिएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 149.0,
          "t": 159.33333333333334,
          "r": 371.6666666666667,
          "b": 199.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "एक प्रदेश सभा सदस्य निर्वाचन क्षेत्र, एक प्राङ्गारिक मल कारखाना स्थापना कार्यक्रमलाई स्थानीय तह र निजी क्षेत्रको साझेदारीमा थप विस्तार गर्ने ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 373.0,
          "t": 158.0,
          "r": 523.3333333333334,
          "b": 200.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| चार साझेदारसँग प्राङ्गारिक मल कारखाना निर्माणका लागि समझदारी पत्रमा हस्ताक्षर भएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.0,
          "t": 177.0,
          "r": 134.0,
          "b": 183.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "४४",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 149.0,
          "t": 205.0,
          "r": 371.6666666666667,
          "b": 245.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "निजी क्षेत्र तथा सहकारीहरूको समन्वयमा प्रत्येक जिल्लामा ।सूचना प्रविधिमा आधारित कृषि उपज बजार केन्द्रहरू सञ्चालन गर्ने ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 373.6666666666667,
          "t": 203.66666666666666,
          "r": 523.6666666666666,
          "b": 234.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| कृषि तथा पशुपन्छी उपज बजार केन्द्र | स्थापना नभएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.0,
          "t": 222.66666666666666,
          "r": 133.33333333333334,
          "b": 230.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "४६",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.66666666666667,
          "t": 261.0,
          "r": 134.0,
          "b": 268.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "५०",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 149.0,
          "t": 250.0,
          "r": 371.6666666666667,
          "b": 278.3333333333333,
