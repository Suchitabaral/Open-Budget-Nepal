        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "नीति तथा कार्यक्रमको संक्षिप्त बेहोरा",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 434.0,
