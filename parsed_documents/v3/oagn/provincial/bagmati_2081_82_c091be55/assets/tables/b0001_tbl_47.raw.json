        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| कार्यक्रम कार्यान्वयन नभएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      }
