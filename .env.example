# Docker Compose ports
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=8080

# PostgreSQL (development defaults; change for a public deployment)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_budget_nepal

# Browser-facing API URL compiled into the frontend image
VITE_API_BASE_URL=http://localhost:3001/api

# Comma-separated browser origins accepted by the API
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Optional RAG profile
RAG_PORT=8000
PINECONE_API_KEY=
PINECONE_INDEX_NAME=budgetrag
PINECONE_NAMESPACE=codefest2025
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_RETRIEVAL_K=3
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.1
