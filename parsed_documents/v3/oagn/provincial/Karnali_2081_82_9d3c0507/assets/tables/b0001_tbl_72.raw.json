        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "'बजेट वक्तव्यको",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 204.03547962009907,
          "t": 296.1146842185408,
          "r": 330.0899156332016,
          "b": 311.65734542161226,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "बजेट कक्तव्यमा उल्लेखित संक्षिप्त बेहोरा",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 421.07656836509705,
          "t": 296.14738484472036,
          "r": 483.90200304985046,
          "b": 311.5980615615845,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "कार्यान्वयन अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 154.71506491303444,
          "t": 324.0793037265539,
          "r": 379.91328024864197,
          "b": 378.0653028637171,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "अन्तरप्रदेश जोड्ने सडक अन्तर्गतका मुलपानी-रानीघाट-तेलपानी-भुरीगाउँ सडक, कालीकोट-कोटवाडा-राष्कोट-रामारोशन सडक, रारा-धुराचौर- बाजुरा सडक र सल्यान खलङ्गा-कालिमाटी-कोहलपुर सडक निर्माण तथा स्तरोन्नति",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 119.83788713254035,
          "t": 339.3333333333333,
          "r": 148.66666666666666,
          "b": 360.0691800415516,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "८५ ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 384.71946835517883,
          "t": 335.2683805003762,
          "r": 519.0102815628052,
          "b": 365.58588325977325,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| अन्तरप्रदेश जोड्ने उल्लिखित सडक | निर्माणाधिन अवस्था रहेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 153.48865032196045,
          "t": 378.812201872468,
          "r": 380.91270530223846,
          "b": 417.81034341454506,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "विश्व बैङ्कको सहयोगमा सञ्चालन हुने प्रादेशिक तथा स्थानीय सडक सुधार आयोजना अन्तर्गत डुङ्गेघर-डाँडापराजुली सडक दैलेख र गल्फागाड- थाडौाँकटे अदानचुली हुम्ला सडक स्तरोन्नति",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 119.72116663306952,
          "t": 391.4313444048166,
          "r": 151.33333333333334,
          "b": 407.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "८६ ।|",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 382.3333333333333,
          "t": 391.1668435484171,
          "r": 459.63568437099457,
          "b": 407.3333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| कार्यान्वयन भैरहेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 146.0,
          "t": 424.02410197257996,
          "r": 382.3696140050888,
          "b": 455.39396834373474,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "- वहुवर्षीय तथा स्रोत सुनिश्चितता भइ कार्यान्वयनमा रहेका तथा दायित्व | सिर्जना छ तोकिएको सिर्जना भएका आयोजनाहरू तोकिएको समयभित्र सम्पन्न गर्ने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 388.6451383829117,
          "t": 419.4501893222332,
          "r": 518.4105271100998,
          "b": 460.07034942507744,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "समयमानै सम्पन्न गर्ने कार्यलाई N N प्राथमिकता दिईएको र सो अनुरुपको N पहल भएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 116.89506844244897,
          "t": 432.42123463749886,
          "r": 138.86782421916723,
          "b": 447.9095202386379,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "१००",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 145.33333333333334,
          "t": 473.8280525803566,
          "r": 384.1092498898506,
          "b": 517.4779031276703,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सङ्घ र स्थानीय तहसँगको सहकार्य गरी आधा घण्टाको हिँडाई दुरी भित्र . धा T गरी झोलुङ्गे कार्यलाई N | पहुँच सुविधा पुर गरी झोलुङ्गे पुल निर्माण कार्यलाई तीव्र गतिमा र बढाउन =N A अगाडि बढाउन ९० वटा थप झोलुङ्गे पुल निर्माण गरिने",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 386.6638857126236,
          "t": 481.7410050332546,
          "r": 519.3682452440262,
          "b": 510.0780083537102,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "यस आर्थिक वर्षमा ३४ वटा झोलुङ्गे पुल सम्पन्न भएको रौ निर्माण सम्पन्न भएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 117.17703365907073,
          "t": 488.49198707938194,
          "r": 138.83337810635567,
          "b": 503.8773182332516,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 4,
        "end_row_offset_idx": 5,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "१०३",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 383.67935544252396,
          "t": 528.281801879406,
          "r": 519.4438297152519,
          "b": 584.7135834097862,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "रुकुम -पश्चिममा ट्रायल सेन्टर तयार | -- भएको। सुर्खेतमा कार्यान्वयनको चरणमा रहेको = रहेको। सवारी चालक अनुमति पत्र N छपाइ मुद्रण विभागबाट भैरहेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 151.39838302135468,
          "t": 532.1164432764053,
          "r": 383.12774538993835,
          "b": 579.082193851471,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सुर्खेत र रुकुम पश्चिम जिल्लामा ट्रायल सेन्टर निर्माण गर्न तथा जुम्ला जिल्लामा रह मर्मत > < रहेको ट्रायल सेन्टर मर्मत र प्रदेशमा नै सवारी चालक अनुमतिपत्र छपाइ तथा वितरण गर्ने 3",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 116.20420593209565,
          "t": 549.9728971719742,
          "r": 139.34269403666258,
          "b": 565.6071766614914,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 5,
        "end_row_offset_idx": 6,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "१०४",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 149.673498660326,
          "t": 583.7039116024971,
          "r": 378.70323276519775,
          "b": 650.4636469483376,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रदेश राजधानी पूर्वाधार विकास कार्यक्रम अन्तर्गत बीरेन्द्रनगर सुर्खेतलाई स्वच्छ सुन्दर र व्यवस्थित शहरको रुपमा विकास र प्रदेश > > | सरकारका मन्त्रालयहरूलाई एकीकृत स्थानमा स्थानान्तरण गर्न प्रदेश महत्वको आयोजनाको - शासनिक त्वको आयोजनाको रूपमा एकीकृत प्रश भवन तथा परिसर निर्माण",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 383.81690376996994,
          "t": 602.8561118841171,
          "r": 518.6467751860619,
          "b": 632.1939442157745,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "- एकीकृत प्रशासकीय भवनको बोलपत्र आव्हान 3 रहेको व्हान भई सम्झौताको चरणमा रहेको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 117.34323995932937,
          "t": 610.2642419338226,
          "r": 138.66128735244274,
          "b": 626.0042569637299,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 6,
        "end_row_offset_idx": 7,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "११०",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 117.90176207013428,
          "t": 655.6242757439613,
          "r": 151.33333333333334,
          "b": 672.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "१११ |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 152.99945151805878,
          "t": 655.1118795871735,
          "r": 369.9545974135399,
          "b": 670.3795408010483,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "भवनसँग सम्बन्धित कानुन तथा भवन संहिता निर्माण गरी कार्यान्वयन",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 379.3333333333333,
          "t": 654.990429520607,
          "r": 471.9394493699074,
          "b": 672.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 7,
        "end_row_offset_idx": 8,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "। तर्जुमाको चरणमा रहेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 150.7917685508728,
          "t": 677.8172908425331,
          "r": 382.32378113269806,
          "b": 733.1740043759346,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 8,
        "end_row_offset_idx": 9,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "जाजरकोटको रामिडाँडा केन्द्रविन्दु भएर गएको भूकम्पबाट प्रभावित जाजरकोट, रुकुम पश्चिम लगायतका जिल्लाका क्षतिग्रस्त स्वास्थ्य तथा शिक्षण संस्था लगायतका पूर्वाधार संरचनाहरूको पुनर्निर्माण, ब्यूल्ड व्याक बेटर (बिबिबि) को मूल मान्यतामा रही यस्ता भवन संरचनाहरू निर्माण",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 385.3078888654709,
          "t": 676.8566256761551,
          "r": 519.3355855941772,
          "b": 733.1017229557037,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 8,
        "end_row_offset_idx": 9,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "| जाजरकोट, सल्यान र रुकुम-पश्चिममा | भुकम्पबाट क्षतिग्रस्त विद्यालय र स्वास्थ्य | चौकिहरूको पुननिर्माण सञ्चालनमा | रहेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 117.77761609852314,
          "t": 697.069988489151,
          "r": 138.67254983633757,
          "b": 712.9883714914322,
