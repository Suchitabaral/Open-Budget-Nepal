        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "नीति तथा कार्यक्रमको बेहोरा",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 407.6666666666667,
          "t": 94.66666666666667,
          "r": 475.3333333333333,
          "b": 104.33333333333333,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 0,
        "end_row_offset_idx": 1,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "कार्यान्वयन अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 153.33333333333334,
          "t": 110.33333333333333,
          "r": 351.3333333333333,
          "b": 150.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "प्रयोग गर्ने तथा सार्वजनिक निकायहरूमा स्वदेशी काठबाट निर्मित फर्निचरहरूको प्रयोग प्राथमिकताका साथ गर्ने व्यवस्था मिलाउने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 355.0,
          "t": 110.33333333333333,
          "r": 521.6666666666666,
          "b": 139.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 1,
        "end_row_offset_idx": 2,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "गरिएकोमा सोको कार्यान्वयन अवस्था | नखुलेको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 153.33333333333334,
          "t": 155.66666666666666,
          "r": 351.3333333333333,
          "b": 181.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "सार्वजनिक,निजी,सहकारी, सामुदायिक क्षेत्रसँगको साझेदारीमा काष्ठ सिजनिङ्ग प्लान्ट सञ्चालन गरिने।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.33333333333333,
          "t": 166.33333333333334,
          "r": 134.0,
          "b": 173.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "Ty",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 361.3333333333333,
          "t": 163.66666666666666,
          "r": 513.6666666666666,
          "b": 174.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 2,
        "end_row_offset_idx": 3,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "काष्ठ सिजनिङ्ग प्लान्ट सञ्चालनमा नआएको |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 153.33333333333334,
          "t": 187.0,
          "r": 351.3333333333333,
          "b": 257.0,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "बन तथा वातावरण संरक्षण र सम्बर्द्धन क्षेत्रबाट रोजगारी सिर्जना गर्न, बाँझो तथा अन्य खेर गइरहेका |जग्गामा वन विकास, पर्यापर्यटन, उद्यम सञ्चालन तथा वनको पत्करबाट मल बनाउने कार्यमा युवा प्रोत्साहन गर्ने कार्यक्रम सञ्चालन गर्ने |",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 122.33333333333333,
          "t": 219.66666666666666,
          "r": 133.66666666666666,
          "b": 227.33333333333334,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 0,
        "end_col_offset_idx": 1,
        "text": "८९",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 361.3333333333333,
          "t": 209.66666666666666,
          "r": 521.6666666666666,
          "b": 235.66666666666666,
          "coord_origin": "TOPLEFT"
        },
        "row_span": 1,
        "col_span": 1,
        "start_row_offset_idx": 3,
        "end_row_offset_idx": 4,
        "start_col_offset_idx": 2,
        "end_col_offset_idx": 3,
        "text": "कार्यक्रम कार्यान्वयन गर्न बजेट विनियोजन नभएको ।",
        "column_header": false,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 153.33333333333334,
          "t": 261.6666666666667,
          "r": 351.3333333333333,
          "b": 303.0,
          "coord_origin": "TOPLEFT"
        },
