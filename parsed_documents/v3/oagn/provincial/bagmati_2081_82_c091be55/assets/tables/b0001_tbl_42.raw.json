        "start_col_offset_idx": 1,
        "end_col_offset_idx": 2,
        "text": "कार्यान्वयन अवस्था",
        "column_header": true,
        "row_header": false,
        "row_section": false,
        "fillable": false
      },
      {
        "bbox": {
          "l": 113.0,
